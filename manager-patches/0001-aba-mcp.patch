diff --git a/src/pages/instance/Mcp/index.tsx b/src/pages/instance/Mcp/index.tsx
new file mode 100644
index 0000000..886c4c2
--- /dev/null
+++ b/src/pages/instance/Mcp/index.tsx
@@ -0,0 +1,122 @@
+// Página MCP (build próprio da Acronomus): o servidor MCP é um só para a Evolution inteira. Mostra
+// a URL (/mcp) e a configuração para o Claude Code, o Claude (claude.ai / Desktop) e outros
+// clientes, com a chave como marcador: quem conecta coloca a própria.
+import { Copy } from "lucide-react";
+import { useEffect, useMemo, useState } from "react";
+import { useTranslation } from "react-i18next";
+
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
+
+import { TOKEN_ID } from "@/lib/queries/token";
+
+import { copyToClipboard } from "@/utils/copy-to-clipboard";
+
+type McpStatus = "checking" | "on" | "off" | "unknown";
+
+function CodeBlock({ code }: { code: string }) {
+  return (
+    <div className="relative">
+      <pre className="overflow-x-auto whitespace-pre-wrap break-all rounded-md bg-muted p-3 pr-12 text-xs">{code}</pre>
+      <Button variant="ghost" size="icon" className="absolute right-1 top-1" onClick={() => copyToClipboard(code)}>
+        <Copy size="15" />
+      </Button>
+    </div>
+  );
+}
+
+function Mcp() {
+  const { t } = useTranslation();
+  const [status, setStatus] = useState<McpStatus>("checking");
+
+  const apiUrl = (localStorage.getItem(TOKEN_ID.API_URL) || window.location.origin).replace(/\/+$/, "");
+  const mcpUrl = `${apiUrl}/mcp`;
+  const key = t("mcp.keyPlaceholder");
+
+  // Sem chave: 401 = MCP ligado; 404 = MCP_ENABLED desligado no servidor.
+  useEffect(() => {
+    let cancelled = false;
+    fetch(mcpUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json", accept: "application/json, text/event-stream" },
+      body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "ping" }),
+    })
+      .then((res) => !cancelled && setStatus(res.status === 404 ? "off" : res.status === 401 ? "on" : "unknown"))
+      .catch(() => !cancelled && setStatus("unknown"));
+    return () => {
+      cancelled = true;
+    };
+  }, [mcpUrl]);
+
+  const configs = useMemo(
+    () => ({
+      claudeCode: `claude mcp add --transport http evolution ${mcpUrl} --header "Authorization: Bearer ${key}"`,
+      json: JSON.stringify(
+        { mcpServers: { evolution: { type: "http", url: mcpUrl, headers: { Authorization: `Bearer ${key}` } } } },
+        null,
+        2,
+      ),
+    }),
+    [mcpUrl, key],
+  );
+
+  return (
+    <div className="mx-auto flex w-full max-w-4xl flex-col gap-6 px-4 py-6">
+      <div>
+        <div className="flex items-center gap-3">
+          <h3 className="text-lg font-medium">{t("mcp.title")}</h3>
+          {status === "on" && <Badge>{t("mcp.status.on")}</Badge>}
+          {status === "off" && <Badge variant="destructive">{t("mcp.status.off")}</Badge>}
+          {status === "unknown" && <Badge variant="secondary">{t("mcp.status.unknown")}</Badge>}
+        </div>
+        <p className="mt-1 text-sm text-muted-foreground">{t("mcp.description")}</p>
+        {status === "off" && <p className="mt-2 text-sm text-destructive">{t("mcp.offHint")}</p>}
+      </div>
+
+      <section className="flex flex-col gap-2">
+        <h4 className="text-sm font-medium">{t("mcp.url")}</h4>
+        <CodeBlock code={mcpUrl} />
+      </section>
+
+      <p className="text-sm text-muted-foreground">{t("mcp.keyHint")}</p>
+
+      <Tabs defaultValue="claude-code">
+        <TabsList>
+          <TabsTrigger value="claude-code">Claude Code</TabsTrigger>
+          <TabsTrigger value="claude">Claude (claude.ai / Desktop)</TabsTrigger>
+          <TabsTrigger value="json">{t("mcp.others")}</TabsTrigger>
+        </TabsList>
+
+        <TabsContent value="claude-code" className="flex flex-col gap-2">
+          <p className="text-sm text-muted-foreground">{t("mcp.claudeCode")}</p>
+          <CodeBlock code={configs.claudeCode} />
+        </TabsContent>
+
+        <TabsContent value="claude" className="flex flex-col gap-3">
+          <ol className="list-decimal space-y-1 pl-5 text-sm text-muted-foreground">
+            <li>{t("mcp.claude.step1")}</li>
+            <li>{t("mcp.claude.step2")}</li>
+            <li>{t("mcp.claude.step3")}</li>
+          </ol>
+          <CodeBlock code={mcpUrl} />
+          <CodeBlock code={`Authorization: Bearer ${key}`} />
+          <p className="text-xs text-muted-foreground">{t("mcp.claude.note")}</p>
+        </TabsContent>
+
+        <TabsContent value="json" className="flex flex-col gap-2">
+          <p className="text-sm text-muted-foreground">{t("mcp.json")}</p>
+          <CodeBlock code={configs.json} />
+        </TabsContent>
+      </Tabs>
+
+      <section className="flex flex-col gap-1 text-sm text-muted-foreground">
+        <h4 className="font-medium text-foreground">{t("mcp.toolsTitle")}</h4>
+        <p>{t("mcp.tools")}</p>
+        <p>{t("mcp.safety")}</p>
+      </section>
+    </div>
+  );
+}
+
+export { Mcp };
